{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Qwen Image Local",
  "version": "0.1.0",
  "identifier": "io.github.mats2208.qwenimagelocal",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Qwen Image Local",
        "width": 1360,
        "height": 880,
        "minWidth": 1060,
        "minHeight": 680,
        "center": true,
        "dragDropEnabled": true,
        "backgroundColor": "#f7f7f6"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Mats2208",
    "shortDescription": "Qwen-Image-2.1 on your 12 GB GPU",
    "copyright": "MIT \u00a9 Mats2208",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}